# ---------------------------------------------------------------------------
# 配置模板。容器化部署时请复制到 data/.env（或直接编辑 data/.env）：
#   mkdir -p data && cp .env.example data/.env
# 程序会读写该文件，Cookie 自动刷新结果会写回其中，容器重建后仍然生效。
# ---------------------------------------------------------------------------

# ===== 必填 =====
# 模型平台 API Key（默认通义千问，从阿里云百炼控制台获取）
API_KEY=默认使用通义千问,apikey通过百炼模型平台获取
# 闲鱼网页端 Cookie。获取方式：浏览器登录闲鱼 → F12 → Network → Fetch/XHR
# → 任选一个请求 → 复制请求头中的完整 Cookie
COOKIES_STR=your_cookies_here

# ===== 模型 =====
# 兼容 OpenAI 协议的服务地址；使用其他厂商时改这里
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max

# ===== 行为 =====
# 人工接管切换关键词，发送该内容即切换接管/自动回复
TOGGLE_KEYWORDS=。
# 是否模拟人工输入延迟，降低被识别为机器人的概率
SIMULATE_HUMAN_TYPING=False

# ===== 日志 =====
# DEBUG / INFO / WARNING / ERROR。容器长期运行建议 INFO，避免日志量过大
LOG_LEVEL=INFO
